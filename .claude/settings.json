{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.staging)",
      "Read(./.env.staging.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.history/**)",
      "Read(./app/data/**)",
      "Read(./data/**)",
      "Read(**/credentials.bin)",
      "Bash(node scripts/github-mcp-headers.mjs *)",
      "Bash(node ./scripts/github-mcp-headers.mjs *)",
      "Bash(node ../scripts/github-mcp-headers.mjs *)",
      "PowerShell(node scripts/github-mcp-headers.mjs *)",
      "PowerShell(node ./scripts/github-mcp-headers.mjs *)",
      "PowerShell(node ../scripts/github-mcp-headers.mjs *)"
    ]
  }
}
