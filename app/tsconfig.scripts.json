{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["scripts/**/*.mjs", "../scripts/**/*.mjs"],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": true,
    "types": ["node"]
  }
}
