{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "tests/**/*",
    "src/**/*",
    "scripts/**/*.mjs",
    "vite-plugins/**/*",
    "vitest.config.ts"
  ],
  "exclude": ["src/preload/index.ts"],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "electron-vite/node"]
  }
}
