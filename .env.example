# Template for the two env files at the repo root: .env.staging and .env.production.
# Both are gitignored and hold secrets only. See docs/ENVIRONMENTS.md.
# Never give a secret a MAIN_VITE_, PRELOAD_VITE_ or RENDERER_VITE_ prefix:
# electron-vite bundles those into the app. No other prefix is bundled
# (envPrefix in app/electron.vite.config.ts).

# .env.staging only: read-only GitHub token for Claude Code's GitHub MCP server.
# See docs/SETUP.md.
GITHUB_MCP_PAT=
